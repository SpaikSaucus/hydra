# Copy to .env and set your own values before running build-apk.sh / build-apk.bat.
# These sign the release APK. The .env file is git-ignored.
#
# IMPORTANT: the first release build generates hydra-release.keystore (git-ignored)
# in the project root and later builds REUSE it so upgrades install in place.
# Once that file exists these passwords must NOT change (they unlock the keystore).
# Back up both .env and hydra-release.keystore together.
KEYSTORE_PASSWORD=changeit
KEY_ALIAS=hydra
KEY_PASSWORD=changeit
