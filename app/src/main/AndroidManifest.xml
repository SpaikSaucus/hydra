<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission WE declare, and the only one the user grants (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      NOTE: WorkManager (androidx.work) merges in a few NORMAL, install-time permissions for
      reliable background scheduling: ACCESS_NETWORK_STATE, WAKE_LOCK, RECEIVE_BOOT_COMPLETED,
      FOREGROUND_SERVICE. None are runtime/privacy permissions and none grant network access.
      We deliberately NEVER declare INTERNET nor any location/sensor permission, so no data can
      leave the device.
    -->

    <application
        android:name=".HydraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hydra.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Hydra.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification action handler. Not exported: only our PendingIntents. -->
        <receiver
            android:name=".reminder.ReminderActionReceiver"
            android:exported="false" />

    </application>
</manifest>
