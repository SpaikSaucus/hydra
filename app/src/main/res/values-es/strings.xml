    <plurals name="pause_active">
        <item quantity="one">En pausa hasta el %1$s (queda %2$d día)</item>
        <item quantity="other">En pausa hasta el %1$s (quedan %2$d días)</item>
    </plurals>
    <string name="pause_resume">Reanudar ahora</string>
    <plurals name="pause_banner">
        <item quantity="one">Registro en pausa · queda %1$d día</item>
        <item quantity="other">Registro en pausa · quedan %1$d días</item>
    </plurals>
    <string name="pause_confirm_title">¿Pausar por %1$d días?</string>
    <string name="pause_confirm_msg">Se detendrán los recordatorios y los días en pausa no cortarán tu racha. El registro se reanuda solo, o antes si tocás Reanudar.</string>
    <string name="pause_button">Pausar</string>

    <!-- v3: balance mañana/tarde -->
    <string name="balance_label">Balance mañana/tarde</string>
    <string name="balance_value">%1$d%% / %2$d%%</string>
    <string name="balance_hint">Adelanta tu objetivo a la primera mitad del día para que quede menos para la tarde: menos idas al baño de madrugada y mejor sueño.</string>
    <string name="about_balance">El balance mañana/tarde es orientativo, no un consejo médico: lo que más importa para tu salud es el total diario. Si tenés enfermedad renal o cardíaca, tomás diuréticos o estás embarazada, consultá a tu médico antes de cambiar tu horario de líquidos.</string>

