    </plurals>
    <string name="pause_resume">Resume now</string>
    <plurals name="pause_banner">
        <item quantity="one">Tracking paused · %1$d day left</item>
        <item quantity="other">Tracking paused · %1$d days left</item>
    </plurals>
    <string name="pause_confirm_title">Pause for %1$d days?</string>
    <string name="pause_confirm_msg">Reminders will stop and paused days won\'t break your streak. Tracking resumes automatically, or earlier if you tap Resume.</string>
    <string name="pause_button">Pause</string>

    <!-- v3: morning/afternoon balance -->
    <string name="balance_label">Morning/afternoon balance</string>
    <string name="balance_value">%1$d%% / %2$d%%</string>
    <string name="balance_hint">Front-loads your goal into the morning half of your day so less is left for the evening — fewer night-time bathroom trips means better sleep.</string>
    <string name="about_balance">The morning/afternoon balance is a guide, not medical advice: what matters most for your health is the daily total. If you have kidney or heart disease, take diuretics or are pregnant, ask your doctor before changing your fluid schedule.</string>

