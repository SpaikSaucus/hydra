    <!-- v3: pause tracking -->
    <string name="section_pause">Pause tracking</string>
    <string name="pause_desc">Trip, illness or just need a break? Pause reminders for a few days instead of uninstalling. Paused days don\'t break your streak, and you can still log water if you want.</string>
    <string name="pause_days_option">%1$d days</string>
