    <!-- About / disclaimers -->
    <string name="about_offline">100% offline. No data ever leaves your device.</string>
    <string name="about_pure_water">Only pure water counts toward your goal — tea, coffee or other drinks are not counted.</string>
    <string name="about_activity">Physical activity increases your needs (not included in the calculation).</string>
    <string name="about_hourly_cap">Keep intake under ~1 L per hour to protect your kidneys.</string>
    <string name="about_season_limit">The season is inferred offline; real weather can\'t be known without internet or a sensor.</string>

